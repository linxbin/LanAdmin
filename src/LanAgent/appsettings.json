{
  "Agent": {
    "HeartbeatSeconds": 30
  },
  "Bootstrap": {
    "ServerBaseUrls": [
      "http://lanadmin-server:5000",
      "http://server:5000",
      "http://localhost:5000"
    ],
    "EndpointPath": "/api/bootstrap/agent",
    "DiscoveryUdpPort": 5010,
    "DiscoveryTimeoutMilliseconds": 3000,
    "DiscoveryRetryCount": 3
  },
  "FileLogging": {
    "Path": "logs/lanagent.log",
    "MinimumLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
