<Window x:Class="LanAdmin.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanAdmin Console"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DeviceGroupExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="12,10"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="ArrowText"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="#374151"
                                           Text="▶" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowText" Property="Text" Value="▼" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceGroupExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource DeviceGroupExpanderToggleStyle}">
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <Border x:Name="ExpandSite"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12"
                Background="#F3F4F6"
                CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="设备搜索" />
                    <TextBox x:Name="SearchTextBox"
                             Width="220"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                    <Button Width="80"
                            Margin="0,0,8,0"
                            Click="SearchButton_Click"
                            Content="查询" />
                    <Button Width="80"
                            Click="RefreshButton_Click"
                            Content="刷新" />
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="准备就绪" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Margin="0,0,12,0"
                      Header="设备列表">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedDeviceTextBlock"
                               Margin="0,0,0,8"
                               Foreground="#4B5563"
                               Text="当前未选中设备" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,8"
                                              Style="{StaticResource DeviceGroupExpanderStyle}"
                                              Collapsed="DeviceGroupExpander_Collapsed"
                                              Expanded="DeviceGroupExpander_Expanded"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="False">
                                                <CheckBox Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding AreAllDevicesChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#4B5563"
                                                           Text="{Binding Summary}" />
                                            </DockPanel>
                                        </Expander.Header>

                                        <StackPanel>
                                            <DataGrid AutoGenerateColumns="False"
                                                      HeadersVisibility="Column"
                                                      IsReadOnly="False"
                                                      ItemsSource="{Binding Devices}"
                                                      Tag="{Binding}"
                                                      Visibility="{Binding DevicesVisibility}">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="选择" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Binding="{Binding HostName}" Header="主机名" IsReadOnly="True" Width="140" />
                                                    <DataGridTextColumn Binding="{Binding StatusDisplay}" Header="状态" IsReadOnly="True" Width="80" />
                                                    <DataGridTextColumn Binding="{Binding UptimeDisplay}" Header="运行时长" IsReadOnly="True" Width="130" />
                                                    <DataGridTextColumn Binding="{Binding ShutdownThresholdDisplay}" Header="关机阈值" IsReadOnly="True" Width="110" />
                                                    <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP" IsReadOnly="True" Width="120" />
                                                    <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC" IsReadOnly="True" Width="140" />
                                                    <DataGridTextColumn Binding="{Binding CurrentUser}" Header="用户" IsReadOnly="True" Width="120" />
                                                    <DataGridTextColumn Binding="{Binding LastSeenAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="最后心跳" IsReadOnly="True" Width="180" />
                                                    <DataGridTextColumn Binding="{Binding AgentVersion}" Header="Agent版本" IsReadOnly="True" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock Margin="12,8,12,12"
                                                       Foreground="#6B7280"
                                                       Text="当前分组暂无设备"
                                                       Visibility="{Binding EmptyStateVisibility}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Margin="0,0,0,12"
                              Header="分组管理">
                        <StackPanel Margin="8">
                            <TextBlock Margin="0,0,0,4" Text="当前选中设备" />
                            <TextBlock x:Name="CurrentDeviceGroupTextBlock"
                                       Margin="0,0,0,12"
                                       Foreground="#4B5563"
                                       Text="未选中设备" />

                            <TextBlock x:Name="SelectedDeviceCountTextBlock"
                                       Margin="0,0,0,12"
                                       Foreground="#4B5563"
                                       Text="当前已勾选 0 台设备" />

                            <TextBlock Margin="0,0,0,6" Text="选中设备加入分组" />
                            <ComboBox x:Name="GroupsComboBox"
                                      Margin="0,0,0,8"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="AssignGroupButton_Click"
                                        Content="加入分组" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="ClearGroupButton_Click"
                                        Content="清空分组" />
                                <Button Width="120"
                                        Click="DeleteDeviceButton_Click"
                                        Content="删除设备" />
                            </StackPanel>

                            <TextBlock Margin="0,0,0,6" Text="关机阈值（天）" />
                            <TextBox x:Name="ShutdownThresholdTextBox" Margin="0,0,0,8" />
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="SetShutdownThresholdButton_Click"
                                        Content="设置关机阈值" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="PromptShutdownReminderButton_Click"
                                        Content="手动弹关机提醒" />
                                <Button Width="120"
                                        Click="ResetShutdownThresholdButton_Click"
                                        Content="恢复默认7天" />
                            </StackPanel>

                            <TextBlock Margin="0,0,0,6" Text="新分组名称" />
                            <TextBox x:Name="GroupNameTextBox" Margin="0,0,0,8" />
                            <Button Width="120"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Click="CreateGroupButton_Click"
                                    Content="创建分组" />

                            <TextBlock Margin="0,0,0,6" Text="已有分组" />
                            <ListBox x:Name="ManageGroupsListBox"
                                     Height="120"
                                     Margin="0,0,0,8"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ManageGroupsListBox_SelectionChanged" />
                            <TextBox x:Name="EditGroupNameTextBox" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="RenameGroupButton_Click"
                                        Content="重命名分组" />
                                <Button Width="120"
                                        Click="DeleteGroupButton_Click"
                                        Content="删除分组" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,0,0,12"
                              Header="弹窗样式">
                        <StackPanel Margin="8">
                            <TextBlock Margin="0,0,0,6" Text="标题" />
                            <TextBox x:Name="ReminderTitleTextBox" Margin="0,0,0,8" />

                            <TextBlock Margin="0,0,0,6" Text="内容模板" />
                            <TextBox x:Name="ReminderContentTextBox"
                                     Height="64"
                                     Margin="0,0,0,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="按钮文字" />
                                    <TextBox x:Name="ReminderButtonTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="弹窗位置" />
                                    <ComboBox x:Name="ReminderPositionComboBox">
                                        <ComboBoxItem Content="右下角" Tag="BottomRight" />
                                        <ComboBoxItem Content="左下角" Tag="BottomLeft" />
                                        <ComboBoxItem Content="右上角" Tag="TopRight" />
                                        <ComboBoxItem Content="左上角" Tag="TopLeft" />
                                        <ComboBoxItem Content="居中" Tag="Center" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="宽" />
                                    <TextBox x:Name="ReminderWidthTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="高" />
                                    <TextBox x:Name="ReminderHeightTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="圆角" />
                                    <TextBox x:Name="ReminderCornerRadiusTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="边框" />
                                    <TextBox x:Name="ReminderBorderWidthTextBox" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="背景色" />
                                    <TextBox x:Name="ReminderBackgroundColorTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="边框色" />
                                    <TextBox x:Name="ReminderBorderColorTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="按钮色" />
                                    <TextBox x:Name="ReminderButtonBackgroundColorTextBox" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,0,0,6" Text="背景图片 URL" />
                            <DockPanel Margin="0,0,0,8">
                                <Button Width="80"
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        Click="UploadReminderBackgroundImageButton_Click"
                                        Content="上传" />
                                <TextBox x:Name="ReminderBackgroundImageUrlTextBox" />
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="图片布局" />
                                    <ComboBox x:Name="ReminderBackgroundImageLayoutComboBox">
                                        <ComboBoxItem Content="等比缩放" Tag="Zoom" />
                                        <ComboBoxItem Content="拉伸填充" Tag="Stretch" />
                                        <ComboBoxItem Content="居中" Tag="Center" />
                                        <ComboBoxItem Content="平铺" Tag="Tile" />
                                        <ComboBoxItem Content="原始尺寸" Tag="None" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="图标" />
                                    <ComboBox x:Name="ReminderIconTypeComboBox">
                                        <ComboBoxItem Content="警告" Tag="Warning" />
                                        <ComboBoxItem Content="信息" Tag="Information" />
                                        <ComboBoxItem Content="错误" Tag="Error" />
                                        <ComboBoxItem Content="成功" Tag="Success" />
                                        <ComboBoxItem Content="不显示" Tag="None" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="置顶" />
                                    <CheckBox x:Name="ReminderTopMostCheckBox"
                                              VerticalAlignment="Center"
                                              Content="弹窗置顶" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="标题字号" />
                                    <TextBox x:Name="ReminderTitleFontSizeTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="标题样式" />
                                    <ComboBox x:Name="ReminderTitleFontStyleComboBox">
                                        <ComboBoxItem Content="常规" Tag="Regular" />
                                        <ComboBoxItem Content="加粗" Tag="Bold" />
                                        <ComboBoxItem Content="斜体" Tag="Italic" />
                                        <ComboBoxItem Content="加粗斜体" Tag="BoldItalic" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="标题颜色" />
                                    <TextBox x:Name="ReminderTitleColorTextBox" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="正文字号" />
                                    <TextBox x:Name="ReminderContentFontSizeTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="正文样式" />
                                    <ComboBox x:Name="ReminderContentFontStyleComboBox">
                                        <ComboBoxItem Content="常规" Tag="Regular" />
                                        <ComboBoxItem Content="加粗" Tag="Bold" />
                                        <ComboBoxItem Content="斜体" Tag="Italic" />
                                        <ComboBoxItem Content="加粗斜体" Tag="BoldItalic" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="正文颜色" />
                                    <TextBox x:Name="ReminderContentColorTextBox" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="按钮字号" />
                                    <TextBox x:Name="ReminderButtonFontSizeTextBox" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <TextBlock Margin="0,0,0,4" Text="按钮样式" />
                                    <ComboBox x:Name="ReminderButtonFontStyleComboBox">
                                        <ComboBoxItem Content="常规" Tag="Regular" />
                                        <ComboBoxItem Content="加粗" Tag="Bold" />
                                        <ComboBoxItem Content="斜体" Tag="Italic" />
                                        <ComboBoxItem Content="加粗斜体" Tag="BoldItalic" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Margin="0,0,0,4" Text="按钮文字色" />
                                    <TextBox x:Name="ReminderButtonTextColorTextBox" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,0,0,6" Text="预览" />
                            <Border Padding="8"
                                    Margin="0,0,0,8"
                                    Background="#F3F4F6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">
                                <Viewbox MaxHeight="240"
                                         HorizontalAlignment="Left"
                                         Stretch="Uniform">
                                    <Border x:Name="ReminderPreviewBorder"
                                            Width="420"
                                            Height="220"
                                            Padding="18"
                                            Background="#FFFFFF"
                                            BorderBrush="#DC2626"
                                            BorderThickness="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ReminderPreviewIconColumn" Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ReminderPreviewIconTextBlock"
                                                       Grid.Column="0"
                                                       Margin="0,0,12,0"
                                                       FontSize="34"
                                                       Text="⚠" />
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="ReminderPreviewTitleTextBlock"
                                                           Grid.Row="0"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="ReminderPreviewContentTextBlock"
                                                           Grid.Row="1"
                                                           Margin="0,8,0,8"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button x:Name="ReminderPreviewButton"
                                                        Grid.Row="2"
                                                        Width="120"
                                                        Height="36"
                                                        HorizontalAlignment="Center"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Viewbox>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="SaveReminderStyleButton_Click"
                                        Content="保存弹窗样式" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="PreviewReminderStyleButton_Click"
                                        Content="预览" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Click="ReloadReminderStyleButton_Click"
                                        Content="重新加载" />
                                <Button Width="120"
                                        Click="ResetReminderStyleButton_Click"
                                        Content="恢复默认" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="设备事件记录">
                        <DataGrid x:Name="EventsDataGrid"
                                  Height="280"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding EventType}" Header="事件" Width="110" />
                                <DataGridTextColumn Binding="{Binding Message}" Header="内容" Width="*" />
                                <DataGridTextColumn Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="时间" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
