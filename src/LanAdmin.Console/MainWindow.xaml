<Window x:Class="LanAdmin.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanAdmin Console"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12"
                Background="#F3F4F6"
                CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="设备搜索" />
                    <TextBox x:Name="SearchTextBox"
                             Width="220"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                    <Button Width="80"
                            Margin="0,0,8,0"
                            Click="SearchButton_Click"
                            Content="查询" />
                    <Button Width="80"
                            Click="RefreshButton_Click"
                            Content="刷新" />
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="准备就绪" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Margin="0,0,12,0"
                      Header="设备列表">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedDeviceTextBlock"
                               Margin="0,0,0,8"
                               Foreground="#4B5563"
                               Text="当前未选中设备" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,8"
                                              Collapsed="DeviceGroupExpander_Collapsed"
                                              Expanded="DeviceGroupExpander_Expanded"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="False">
                                                <CheckBox Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding AreAllDevicesChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#4B5563"
                                                           Text="{Binding Summary}" />
                                            </DockPanel>
                                        </Expander.Header>

                                        <DataGrid AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  IsReadOnly="False"
                                                  ItemsSource="{Binding Devices}"
                                                  Tag="{Binding}">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="选择" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding HostName}" Header="主机名" IsReadOnly="True" Width="140" />
                                                <DataGridTextColumn Binding="{Binding Status}" Header="状态" IsReadOnly="True" Width="80" />
                                                <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP" IsReadOnly="True" Width="120" />
                                                <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC" IsReadOnly="True" Width="140" />
                                                <DataGridTextColumn Binding="{Binding CurrentUser}" Header="用户" IsReadOnly="True" Width="120" />
                                                <DataGridTextColumn Binding="{Binding LastSeenAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="最后心跳" IsReadOnly="True" Width="180" />
                                                <DataGridTextColumn Binding="{Binding AgentVersion}" Header="Agent版本" IsReadOnly="True" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Margin="0,0,0,12"
                          Header="分组管理">
                    <StackPanel Margin="8">
                        <TextBlock Margin="0,0,0,4" Text="当前选中设备" />
                        <TextBlock x:Name="CurrentDeviceGroupTextBlock"
                                   Margin="0,0,0,12"
                                   Foreground="#4B5563"
                                   Text="未选中设备" />

                        <TextBlock x:Name="SelectedDeviceCountTextBlock"
                                   Margin="0,0,0,12"
                                   Foreground="#4B5563"
                                   Text="当前已勾选 0 台设备" />

                        <TextBlock Margin="0,0,0,6" Text="选中设备加入分组" />
                        <ComboBox x:Name="GroupsComboBox"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <Button Width="120"
                                    Margin="0,0,8,0"
                                    Click="AssignGroupButton_Click"
                                    Content="加入分组" />
                            <Button Width="120"
                                    Margin="0,0,8,0"
                                    Click="ClearGroupButton_Click"
                                    Content="清空分组" />
                            <Button Width="120"
                                    Click="DeleteDeviceButton_Click"
                                    Content="删除设备" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,6" Text="新分组名称" />
                        <TextBox x:Name="GroupNameTextBox" Margin="0,0,0,8" />
                        <Button Width="120"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Left"
                                Click="CreateGroupButton_Click"
                                Content="创建分组" />

                        <TextBlock Margin="0,0,0,6" Text="已有分组" />
                        <ListBox x:Name="ManageGroupsListBox"
                                 Height="120"
                                 Margin="0,0,0,8"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="ManageGroupsListBox_SelectionChanged" />
                        <TextBox x:Name="EditGroupNameTextBox" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Width="120"
                                    Margin="0,0,8,0"
                                    Click="RenameGroupButton_Click"
                                    Content="重命名分组" />
                            <Button Width="120"
                                    Click="DeleteGroupButton_Click"
                                    Content="删除分组" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="设备事件记录">
                    <DataGrid x:Name="EventsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding EventType}" Header="事件" Width="110" />
                            <DataGridTextColumn Binding="{Binding Message}" Header="内容" Width="*" />
                            <DataGridTextColumn Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="时间" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
