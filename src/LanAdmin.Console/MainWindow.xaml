<Window x:Class="LanAdmin.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanAdmin Console"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12"
                Background="#F3F4F6"
                CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="设备搜索" />
                    <TextBox x:Name="SearchTextBox"
                             Width="220"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                    <Button Width="80"
                            Margin="0,0,8,0"
                            Click="SearchButton_Click"
                            Content="查询" />
                    <Button Width="80"
                            Click="RefreshButton_Click"
                            Content="刷新" />
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="准备就绪" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Margin="0,0,12,0"
                      Header="设备列表">
                <DataGrid x:Name="DevicesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="DevicesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding HostName}" Header="主机名" Width="140" />
                        <DataGridTextColumn Binding="{Binding Status}" Header="状态" Width="80" />
                        <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP" Width="120" />
                        <DataGridTextColumn Binding="{Binding CurrentUser}" Header="用户" Width="120" />
                        <DataGridTextColumn Binding="{Binding GroupName}" Header="分组" Width="120" />
                        <DataGridTextColumn Binding="{Binding LastSeenAt}" Header="最后心跳" Width="180" />
                        <DataGridTextColumn Binding="{Binding AgentVersion}" Header="Agent版本" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Margin="0,0,0,12"
                          Header="分组管理">
                    <StackPanel Margin="8">
                        <TextBlock Margin="0,0,0,6" Text="新分组名称" />
                        <TextBox x:Name="GroupNameTextBox" Margin="0,0,0,8" />
                        <Button Width="120"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Left"
                                Click="CreateGroupButton_Click"
                                Content="创建分组" />

                        <TextBlock Margin="0,0,0,6" Text="选中设备加入分组" />
                        <ComboBox x:Name="GroupsComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Width="120"
                                    Margin="0,0,8,0"
                                    Click="AssignGroupButton_Click"
                                    Content="加入分组" />
                            <Button Width="120"
                                    Click="ClearGroupButton_Click"
                                    Content="清空分组" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="设备事件记录">
                    <DataGrid x:Name="EventsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding EventType}" Header="事件" Width="110" />
                            <DataGridTextColumn Binding="{Binding Message}" Header="内容" Width="*" />
                            <DataGridTextColumn Binding="{Binding OccurredAt}" Header="时间" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
